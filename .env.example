# Optional: enable AI narrative polish (rule-based text is always the default)
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# Optional: semantic image routing fallback for static / harmonic / shock slots
# when rule-based mapping misses (auto-enabled when this key is set)
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-2.5-flash

# Set to 1 to run DPF integration tests against real .rst files
# ANSYS_AVAILABLE=0
